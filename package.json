{
  "name": "@rohal12/spindle-lsp",
  "version": "0.9.0",
  "description": "Language Server Protocol server for Spindle story format",
  "type": "module",
  "bin": {
    "spindle-lsp": "dist/bin.js"
  },
  "scripts": {
    "build": "node esbuild.config.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "duplication": "node scripts/duplication.ts jscpd && node scripts/duplication.ts cpd && node scripts/duplication.ts fallow",
    "smoke:pack": "node scripts/smoke-pack.ts",
    "lint": "tsc --noEmit && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@rohal12/spindle": "0.64.11",
    "@rohal12/twee-ts": "^2.1.0",
    "glob": "^14.0.2",
    "happy-dom": "^21.0.4",
    "minimatch": "^11.0.1",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.16",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "prettier": "^3.9.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fallow": "3.36.0",
    "jscpd": "5.4.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "Unlicense",
  "author": "Rohal12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohal12/spindle-lsp.git"
  }
}
